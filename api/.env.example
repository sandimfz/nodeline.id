# Copy to .env and fill in real values. DO NOT commit .env.

# App
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/nodeline_api

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# Refresh token cookie
REFRESH_COOKIE_NAME=nl_refresh
STOCK_ENCRYPTION_KEY=change_me_32_byte_hex_64_chars_here_please_change_me_32_byte_hex
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# Cloudflare R2 (image storage)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nodeline-images
R2_ACCOUNT_ID=
R2_PUBLIC_URL=https://r2.nodeline.id
R2_UPLOAD_EXPIRES_IN=600
